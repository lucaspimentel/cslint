<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cslint</AssemblyName>

    <!-- Native AOT when semantic rules are excluded (standalone binary) -->
    <PublishAot Condition="'$(PackAsTool)' != 'true' and '$(IncludeSemanticRules)' != 'true'">true</PublishAot>
    <!-- Roslyn 5.x uses Assembly.Location internally, which is incompatible with Native AOT.
         CsLint only uses syntax parsing APIs, not the compiler driver, so this is safe to suppress. -->
    <NoWarn>IL3000</NoWarn>

    <!-- .NET Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cslint</ToolCommandName>

    <!-- NuGet -->
    <PackageId>cslint</PackageId>
    <Version>2.0.0-beta.2</Version>
    <Authors>Lucas Pimentel</Authors>
    <Description>A fast C# linter that reads rules from .editorconfig. Uses Roslyn syntax-only parsing for fast single-file linting.</Description>
    <Copyright>Copyright (c) Lucas Pimentel 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lucaspimentel/cslint</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>csharp;linter;editorconfig;roslyn;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsLint.Core\CsLint.Core.csproj" />
  </ItemGroup>

</Project>
